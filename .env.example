# LapLogger environment variables
# Copy to .env and fill in real values

# PostgreSQL
POSTGRES_USER=laplogger
POSTGRES_PASSWORD=laplogger_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=laplogger_control

# Google OAuth (placeholder — replace with real credentials)
GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-client-secret
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

# Frontend URL (where the backend redirects after OAuth)
FRONTEND_URL=http://localhost

# JWT
JWT_SECRET=dev-secret-change-in-production

# Backend
BACKEND_PORT=8080

# Frontend (Vite dev server)
VITE_API_BASE_URL=http://localhost/api
